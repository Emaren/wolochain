[Unit]
Description=WoloChain mainnet settlement service
After=network-online.target wolochaind-mainnet.service
Requires=wolochaind-mainnet.service

[Service]
User=wolo
Group=wolo
WorkingDirectory=/var/www/WoloChain-mainnet
EnvironmentFile=/etc/wolochain-mainnet-settlement.env
ExecStart=/var/www/WoloChain-mainnet/build/wolochaind settlement serve
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

