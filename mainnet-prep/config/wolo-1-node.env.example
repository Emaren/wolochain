# Example env file matching the verified mainnet service environment path:
# /etc/wolochain-mainnet/wolochaind-mainnet.env.

WOLO_HOME=/var/lib/wolochaind-mainnet
CHAIN_ID=wolo-1
MIN_GAS_PRICES=0.025uwolo

# Intended local binds for generated config.toml / app.toml.
WOLO_MAINNET_P2P_LADDR=tcp://0.0.0.0:27656
WOLO_MAINNET_RPC_LADDR=tcp://127.0.0.1:27657
WOLO_MAINNET_REST_ADDRESS=tcp://127.0.0.1:1318
WOLO_MAINNET_GRPC_ADDRESS=127.0.0.1:9091
WOLO_MAINNET_GRPC_WEB_ADDRESS=127.0.0.1:9092
