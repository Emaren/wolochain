# C03 root-local READ ONLY observer; never a financial fence or payout authority.
# Install only from source-pinned merged PR with exact SHA and host admission.
[Unit]
Description=AoE2WAR C03 financial writer HOLD/drift observer (read only)
After=network.target
ConditionPathIsDirectory=/usr/local/libexec/wolo-c03-observer
ConditionPathIsDirectory=/var/lib/wolo-c03-observer/receipts

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -B /usr/local/libexec/wolo-c03-observer/settlement_c03_observer_watchdog.py --mode once
SuccessExitStatus=3
TimeoutStartSec=120
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/wolo-c03-observer
