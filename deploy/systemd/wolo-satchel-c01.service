# Source-reviewed C01 staging template, NOT an activation permit.
# No [Install] section: this unit MUST NOT be automatically enabled.
# The native binary still validates independent exact-build, config, trust and
# short-lived signed permission at runtime. Missing config remains HOLD.
[Unit]
Description=WOLO C01 protected Satchel custody (8094; held without enrollment)
ConditionPathExists=/etc/wolo-financial-c01/custody.json
StartLimitIntervalSec=300s
StartLimitBurst=1

[Service]
Type=simple
Restart=no
TimeoutStartSec=30s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=512M
TasksMax=96
LimitNOFILE=512
User=wolo-satchel
Group=wolo-satchel
WorkingDirectory=/var/lib/wolo-financial-role-state/v1/custody
ReadWritePaths=/var/lib/wolo-financial-role-state/v1/custody
RuntimeDirectory=wolo-satchel-c01
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/wolo-c01/f7b5a74928e041a6a90ac983d87649e0484677a4/wolosatcheld --config /etc/wolo-financial-c01/custody.json
