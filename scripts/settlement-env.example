# WoloChain settlement executor config
#
# Copy these into the environment for `wolochaind settlement ...` or the
# localhost settlement server. Keep secrets out of git.
#
# These defaults reflect the current live WoloChain testnet posture as of
# April 9, 2026, except for the auth token which must remain secret.

export WOLO_SETTLEMENT_HOME="/var/lib/wolochaind-testnet"
export WOLO_SETTLEMENT_NODE="tcp://127.0.0.1:26657"
export WOLO_SETTLEMENT_RPC_HTTP="http://127.0.0.1:26657"
export WOLO_SETTLEMENT_REST_URL="http://127.0.0.1:1317"
export WOLO_SETTLEMENT_PUBLIC_REST_URL="https://rest.aoe2hdbets.com"

export WOLO_SETTLEMENT_CHAIN_ID="wolo-testnet"
export WOLO_SETTLEMENT_BASE_DENOM="uwolo"
export WOLO_SETTLEMENT_DISPLAY_DENOM="wolo"
export WOLO_SETTLEMENT_ADDRESS_PREFIX="wolo"

# Payout signer: dedicated settlement sender, not your faucet key.
export WOLO_SETTLEMENT_PAYOUT_KEY_NAME="payout"
# Current accepted live rollout path keeps `test` until you deliberately migrate the VPS keyring backend.
export WOLO_SETTLEMENT_KEYRING_BACKEND="test"
export WOLO_SETTLEMENT_PAYOUT_ADDRESS="wolo1cy04t5af0mr9d8n6rrzgr8e9j4vuf42nfg02q5"

# Escrow classification address used by proof / discovery helpers.
# The app must actually send stakes here for WoloChain recovery helpers to see them.
export WOLO_SETTLEMENT_ESCROW_ADDRESS="wolo1t4jq7wd4x030t9f0yfqfq74pt4pmaep5nu67y4"

# Broadcast / fee controls
export WOLO_SETTLEMENT_BROADCAST_MODE="sync"
export WOLO_SETTLEMENT_GAS="auto"
export WOLO_SETTLEMENT_GAS_ADJUSTMENT="1.5"
export WOLO_SETTLEMENT_GAS_PRICES="0.025uwolo"
# Leave fixed fees unset unless you want deterministic grouped-run fee estimates.
export WOLO_SETTLEMENT_FEES=""
export WOLO_SETTLEMENT_MIN_PAYOUT_BALANCE_UWOLO="1000000000"
export WOLO_SETTLEMENT_FEE_HEADROOM_UWOLO="10000000"

# Localhost API server
export WOLO_SETTLEMENT_LISTEN_ADDR="127.0.0.1:8091"
# AoE2HDBets and other callers should send `Authorization: Bearer ...`
export WOLO_SETTLEMENT_AUTH_TOKEN="replace-with-long-random-secret"

# Settlement request and grouped-run state.
export WOLO_SETTLEMENT_STATE_DIR="/mnt/HC_Volume_105319120/wolochain/settlement-state"
