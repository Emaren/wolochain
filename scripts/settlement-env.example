# WoloChain settlement executor config
#
# Copy these into the environment for `wolochaind settlement ...` or the
# localhost settlement server. Keep secrets out of git.
#
# These defaults reflect the current WoloChain mainnet routing posture as of
# June 1, 2026, except for signer addresses and the auth token which must remain
# secret and environment-specific.

export WOLO_SETTLEMENT_HOME="/var/lib/wolochaind-mainnet"
export WOLO_SETTLEMENT_NODE="tcp://127.0.0.1:27657"
export WOLO_SETTLEMENT_RPC_HTTP="http://127.0.0.1:27657"
export WOLO_SETTLEMENT_REST_URL="http://127.0.0.1:1318"
export WOLO_SETTLEMENT_PUBLIC_REST_URL="https://rest-mainnet.aoe2war.com"

export WOLO_SETTLEMENT_CHAIN_ID="wolo-1"
export WOLO_SETTLEMENT_BASE_DENOM="uwolo"
export WOLO_SETTLEMENT_DISPLAY_DENOM="wolo"
export WOLO_SETTLEMENT_ADDRESS_PREFIX="wolo"

# Payout signer: dedicated mainnet settlement sender, not a faucet key.
export WOLO_SETTLEMENT_PAYOUT_KEY_NAME="mainnet-payout"
export WOLO_SETTLEMENT_KEYRING_BACKEND="os"
export WOLO_SETTLEMENT_PAYOUT_ADDRESS="wolo1_REPLACE_WITH_FRESH_MAINNET_PAYOUT"

# Escrow signer and classification address used by proof / discovery helpers.
# Challenge funding verification and optional payout top-ups resolve this key.
export WOLO_SETTLEMENT_ESCROW_KEY_NAME="mainnet-escrow"
# The app must actually send challenge deposits here for funding verification to see them.
export WOLO_SETTLEMENT_ESCROW_ADDRESS="wolo1_REPLACE_WITH_FRESH_MAINNET_ESCROW"
# Optional default treasury route for challenge guarantee forfeits.
export WOLO_SETTLEMENT_TREASURY_ADDRESS="wolo1_REPLACE_WITH_FRESH_MAINNET_TREASURY"
# When enabled, challenge settlement can move only the required shortfall from escrow into
# the payout signer before executing the payout run.
export WOLO_SETTLEMENT_ESCROW_AUTO_TOP_UP_ENABLED="true"

# Broadcast / fee controls
export WOLO_SETTLEMENT_BROADCAST_MODE="sync"
export WOLO_SETTLEMENT_GAS="auto"
export WOLO_SETTLEMENT_GAS_ADJUSTMENT="1.5"
export WOLO_SETTLEMENT_GAS_PRICES="0.025uwolo"
# Leave fixed fees unset unless you want deterministic grouped-run fee estimates.
export WOLO_SETTLEMENT_FEES=""
# Payout-signed grouped runs must leave both the payout reserve floor and fee headroom.
export WOLO_SETTLEMENT_MIN_PAYOUT_BALANCE_UWOLO="1000000000"
export WOLO_SETTLEMENT_FEE_HEADROOM_UWOLO="10000000"
# Escrow-signed grouped runs use separate escrow reserve/headroom values so payout health
# cannot block escrow settlements and payout runs cannot borrow escrow funds.
export WOLO_SETTLEMENT_MIN_ESCROW_BALANCE_UWOLO="10000000"
export WOLO_SETTLEMENT_ESCROW_FEE_HEADROOM_UWOLO="10000000"

# Localhost API server
export WOLO_SETTLEMENT_LISTEN_ADDR="127.0.0.1:8092"
# AoE2War / AoE2HDBets and other callers should send `Authorization: Bearer ...`
export WOLO_SETTLEMENT_AUTH_TOKEN="replace-with-long-random-secret"

# Settlement request and grouped-run state.
export WOLO_SETTLEMENT_STATE_DIR="/mnt/HC_Volume_105319120/wolochain-mainnet/settlement-state"
