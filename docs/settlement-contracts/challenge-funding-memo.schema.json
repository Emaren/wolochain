{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wolochain.local/schemas/challenge-funding-memo.schema.json",
  "title": "AoE2HDBets WoloChain Challenge Funding Memo Fields",
  "description": "Normalized fields for the strict app=aoe2hdbets compact memo contract encoded after wolo.challenge.funding.v1:. The raw memo must contain exactly app, sid, cid, side, w, g, and t once each. sid must also equal aoe2hdbets:challenge-<challenge_id>:v1; that cross-field invariant is enforced by WoloChain code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_app",
    "settlement_run_id",
    "challenge_id",
    "participant_side",
    "wager_uwolo",
    "guarantee_uwolo",
    "total_funded_uwolo"
  ],
  "properties": {
    "source_app": {
      "type": "string",
      "const": "aoe2hdbets"
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "settlement_run_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^aoe2hdbets:challenge-[1-9][0-9]*:v1$"
    },
    "participant_side": {
      "type": "string",
      "enum": ["left", "right"]
    },
    "wager_uwolo": {
      "$ref": "#/$defs/positive_uwolo"
    },
    "guarantee_uwolo": {
      "$ref": "#/$defs/positive_uwolo"
    },
    "total_funded_uwolo": {
      "$ref": "#/$defs/positive_uwolo"
    }
  },
  "$defs": {
    "positive_uwolo": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    }
  }
}
